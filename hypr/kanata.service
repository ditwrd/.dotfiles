[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

# Reference copy of the unit that actually runs on this laptop.  Nothing in
# this flake installs system units (home-manager standalone cannot), so the
# live definition is /usr/lib/systemd/system/kanata.service plus the drop-in
# /etc/systemd/system/kanata.service.d/10-keymap-path.conf, which only
# overrides ExecStart.  Keep the two in sync when either changes.
#
# kanata_cmd_allowed, not kanata: the keymap uses cmd actions.  No -d: that
# switch logs every keystroke at DEBUG, which wrote 72k journal lines per boot
# and pushed the 50M journal cap into vacuuming the kernel phase.
[Service]
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:$HOME/.cargo/bin
Environment=DISPLAY=:0
Type=simple
ExecStart=/usr/bin/kanata_cmd_allowed --cfg /home/dit/.config/kanata/kanata.kbd
Restart=no

[Install]
WantedBy=default.target

{
  "theme": "Dark",
  "reduce_motion": "on",
  "font_size": 16,
  "antialias": false,
  "renderer": "integrated",
  "keybinds": {
    "ctrl+shift+p": [],
    "ctrl+shift+r": "rename_tab",
    "ctrl+space>1": "goto_tab:1",
    "ctrl+space>2": "goto_tab:2",
    "ctrl+space>3": "goto_tab:3",
    "ctrl+space>4": "goto_tab:4",
    "ctrl+space>5": "goto_tab:5",
    "ctrl+space>6": "goto_tab:6",
    "ctrl+space>7": "goto_tab:7",
    "ctrl+space>8": "goto_tab:8",
    "ctrl+space>9": "goto_tab:9",
    "ctrl+space>:": [],
    "ctrl+space>[": "open_scrollback",
    "ctrl+space>c": "new_tab",
    "ctrl+space>e": "toggle_sidebar",
    "ctrl+space>f": "switch_session",
    "ctrl+space>h": "focus_pane:left",
    "ctrl+space>j": "focus_pane:down",
    "ctrl+space>k": "focus_pane:up",
    "ctrl+space>l": "focus_pane:right",
    "ctrl+space>n": "next_tab",
    "ctrl+space>o": "inbox",
    "ctrl+space>s": "preferences",
    "ctrl+space>shift+/": "show_commands",
    "ctrl+space>shift+j": "split_down",
    "ctrl+space>shift+l": "split_right",
    "ctrl+space>shift+n": "new_session",
    "ctrl+space>shift+r": "reload_config",
    "ctrl+space>shift+t": "rename_tab",
    "ctrl+space>shift+tab": "previous_pane",
    "ctrl+space>shift+w": "rename_session",
    "ctrl+space>shift+x": "close_tab",
    "ctrl+space>space": "palette",
    "ctrl+space>tab": "next_pane",
    "ctrl+space>w": "switch_session",
    "ctrl+space>x": "close_pane",
    "ctrl+space>z": "zoom"
  },
  "keymap": "tmux",
  "keymap_prefix": "ctrl+space"
}
